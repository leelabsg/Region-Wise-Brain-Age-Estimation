# ---------------------------------------------------------------------------
# Every filesystem path, host name and container reference used by the GWAS
# pipeline. Copy to config/paths.env and edit; nothing else in gwas/ contains
# a site-specific path.
#
#   cp gwas/config/paths.env.example gwas/config/paths.env
#   $EDITOR gwas/config/paths.env
#
# Shell scripts do `source config/common.sh`, which loads this file.
# Python scripts read the same variables from the environment
# (`set -a; source gwas/config/paths.env; set +a` before running them).
# ---------------------------------------------------------------------------

# --- where this pipeline writes -------------------------------------------
# One directory per cohort; each holds {region}/ subdirectories.
GWAS_UKB_DIR=/path/to/work/ukb
GWAS_ADNI_DIR=/path/to/work/adni

# --- SAIGE ----------------------------------------------------------------
# Either a container image (SAIGE_RUNNER=docker) or a conda/micromamba prefix
# that provides step1_fitNULLGLMM.R / step2_SPAtests.R (SAIGE_RUNNER=conda).
# Both were used in this project.
#
# The UK Biobank run used two SAIGE versions: 1.1.8 for step 1 and 1.1.9 for
# step 2. The SAIGE_*_STEP1 variables below apply to step 1 only; when they are
# unset, step 1 uses the same runner, image and environment as step 2. The
# settings that produced the published UK Biobank results were:
#   step 1  docker, wzhou88/saige:1.1.8
#   step 2  conda,  a SAIGE 1.1.9 prefix
# The ADNI replication used SAIGE 1.1.9 for both steps.
SAIGE_RUNNER=conda
SAIGE_IMAGE=wzhou88/saige:1.1.9
SAIGE_ENV=/path/to/micromamba/envs/saige119
SAIGE_RUNNER_STEP1=docker
SAIGE_IMAGE_STEP1=wzhou88/saige:1.1.8
SAIGE_ENV_STEP1=/path/to/micromamba/envs/saige118
# Host paths bind-mounted into the container (space-separated).
SAIGE_DOCKER_MOUNTS="/path/to/work /path/to/genotypes"

# --- compute nodes --------------------------------------------------------
# Space-separated hosts reachable by passwordless ssh. Set to the empty string
# to run everything locally.
GWAS_NODES=""
# Max concurrent SAIGE step-2 jobs across all nodes.
GWAS_MAXJOBS=20

# --- UK Biobank genotypes (imputed, BGEN v1.2) ----------------------------
# {chr} is replaced by 1..22.
UKB_BGEN_TMPL=/path/to/ukb_imp_chr{chr}_v3.bgen
UKB_BGEN_INDEX_TMPL=/path/to/ukb_imp_chr{chr}_v3.bgen.bgi
UKB_SAMPLE_FILE=/path/to/ukb_imp_v3.sample
# PLINK1 prefix (LD-pruned hardcalls) for the SAIGE step-1 GRM.
UKB_GRM_PLINK=/path/to/UKB_step1
# Phenotype + covariate table (see README "Phenotype table").
UKB_PHENO_FILE=/path/to/ukb_regional_bag_phenotypes.csv
# Step-1 covariate argument list. The default in 01_ukb_gwas/saige_step1.sh is
# the list the published run passed, Sex,Age,Visit,PC1..PC10; Visit was constant
# in the analysed samples and SAIGE excluded it from the fitted model.
# UKB_COVARS=Sex,Age,Visit,PC1,PC2,PC3,PC4,PC5,PC6,PC7,PC8,PC9,PC10

# --- ADNI genotypes -------------------------------------------------------
PLINK2=/path/to/plink2
BGENIX=/path/to/bgenix
ADNI_PFILE=/path/to/adni_combined            # pgen/pvar/psam prefix, dosages
ADNI_PCA_PFILE=/path/to/adni_pca             # LD-pruned set used for the GRM
ADNI_KEEP_IIDS=/path/to/final_qc_keep.iids   # one IID per line
ADNI_SAMPLE_TSV=/path/to/final_qc_samples.tsv
ADNI_EIGENVEC=/path/to/adni_eur_pca.eigenvec
ADNI_COHORT_TSV=/path/to/cohort_indicator.tsv
# Per-region brain-age predictions from the RegionBAE model (see repo root).
ADNI_PRED_TMPL=/path/to/adni_brain_age_{region}_rereg_seed7.csv
# Phenotype + covariate table written by 02_adni_replication/build_pheno.py.
ADNI_PHENO_FILE=/path/to/work/adni/adni_pheno.csv

# --- LDSC -----------------------------------------------------------------
LDSC_DIR=/path/to/ldsc                       # clone of bulik/ldsc
LDSC_PYTHON=python                           # python2.7 with the ldsc env active
LDSC_REF_LD_CHR=/path/to/eur_ref_ld_chr/
LDSC_W_LD_CHR=/path/to/eur_w_ld_chr/
LDSC_WORK_DIR=/path/to/work/ldsc
# External sumstats correlated against the regional BAG GWAS (optional).
# Raw telomere-length GWAS as downloaded from the GWAS Catalog
# (accession GCST90435144; columns rs_id / effect_allele / other_allele /
# effect_allele_frequency / beta / standard_error / chromosome). Input to
# 04_ldsc/00_preprocess_telomere.py; not needed if you already have the
# munged LDSC_TELOMERE_SUMSTATS below.
LDSC_TELOMERE_RAW_SUMSTATS=/path/to/GCST90435144.tsv
LDSC_TELOMERE_SUMSTATS=/path/to/telomere_pc1.sumstats.gz
LDSC_PROTEIN_AGE_SUMSTATS=/path/to/protein_age.sumstats.gz
# Merged SAIGE step-2 output for the ProtAge-204 proteomic-age gap. Input to
# 04_ldsc/01_preprocess.py; not needed if you already have the munged
# LDSC_PROTEIN_AGE_SUMSTATS below.
LDSC_PROTEIN_AGE_RAW_SUMSTATS=/path/to/protage204_imputed_sumstats.txt
# --N passed to munge for each external trait, used by 04_ldsc/00_munge_external.sh.
# Values used for the released sumstats: telomere 438351 (the `n` column of
# GCST90435144), ProtAge-204 43710 (SAIGE step-1 analysed N).
LDSC_TELOMERE_N=438351
LDSC_PROTEIN_AGE_N=43710
# Correlation-table builders (build_rg_table.py / update_rg_table_external.py).
RG_TABLE_OUT=/path/to/work/ldsc/outputs/tables/rg_table.tsv
# Standalone --h2 logs for the external traits named in h2_table_traits.tsv.
LDSC_TELOMERE_H2_LOG=/path/to/telomere_pc1_heritability.log
LDSC_PROTEIN_AGE_H2_LOG=/path/to/heritability_protein_age.log
# How the two external traits are named in the published tables.
TELOMERE_DISPLAY="Telomere Length PC1"
PROTEIN_AGE_DISPLAY=ProtAge-204
# Individual-level proteomic-age gap table, for the phenotypic columns.
PROTEIN_AGE_PHENO_FILE=/path/to/covar_protein_age.csv
# Genetic rows (Trait2, rg, Z, P_log) for the Protein Age family. Required for the
# Protein Age x Telomere Length PC1 row, which is not estimated by this pipeline. Its ten
# Protein Age x BAG rows are used ONLY when PROTAGE_SUBSTITUTE_GENETIC=1.
PROTEIN_AGE_RG_TSV=/path/to/protein_age_ldsc_verified.tsv
# Opt-in: replace the ten Protein Age x BAG genetic estimates that build_rg_table.py read
# from this run's own LDSC logs with the pre-computed rows above. Leave it unset (the
# default) to keep the run's own estimates; the published table was built that way.
# PROTAGE_SUBSTITUTE_GENETIC=1
# Phenotypic r/p/q for Protein Age x BAG (the ProtAge-204 phenotypic correlation output).
PROTEIN_AGE_PHENO_CORR_TSV=/path/to/protein_age_phenotypic_correlations.tsv

# --- MAGMA cell-type ------------------------------------------------------
MAGMA_BIN=/path/to/magma                     # v1.10
# Working root. The cell-type scripts expect the original layout underneath:
#   $MAGMA_ROOT/magma                     the binary
#   $MAGMA_ROOT/data/                     reference panel, annotation, scRNA matrices
#   $MAGMA_ROOT/outputs/                  everything the pipeline writes
MAGMA_ROOT=/path/to/magma_root
# 1000 Genomes phase 3 EUR reference (GRCh37) and its gene annotation.
MAGMA_BFILE=/path/to/g1000_eur
MAGMA_GENE_ANNOT=/path/to/annot_g1000eur_ENSG.genes.annot
# FUMA's pre-processed single-cell expression matrices (celltype/*.txt).
FUMA_SCRNA_DIR=/path/to/FUMA_scRNA_data_v2/celltype
# Where build_manuscript_tables.py reads each region's finalized cell-type output from,
# and where it writes the consolidated tables. Defaults are $MAGMA_ROOT/outputs/step23
# and $MAGMA_ROOT/outputs/manuscript_tables.
# MAGMA_STEP23_DIR=/path/to/magma_root/outputs/step23
# MAGMA_TABLES_DIR=/path/to/magma_root/outputs/manuscript_tables
# Regions whose files are read from a FUMA download directory instead of MAGMA_STEP23_DIR.
# Empty in the build that produced the manuscript tables; the `source` column in tableA /
# tableB records which of the two directories each region was read from, and is not the
# analysis implementation (see gwas/README.md).
# MAGMA_FUMA_CELLTYPE_DIR=/path/to/magma_root/data/fuma_celltype_results
MAGMA_FUMA_REGIONS=
# Merged per-region summary statistics for the lambda_GC panel, relative to GWAS_UKB_DIR.
MAGMA_SUMSTATS_TMPL={region}/{region}_discovery_41067_sumstats.txt
# Per-region magma.genes.raw downloaded from a FUMA SNP2GENE job (see README).
FUMA_GENES_RAW_TMPL=/path/to/fuma_magma/{region}/magma.genes.raw
# Unmodified storage/scripts/magma_celltype.R from the FUMA-webapp repository.
FUMA_CELLTYPE_R=/path/to/magma_celltype.R
RSCRIPT=/path/to/Rscript

# --- PRS / SBayesRC (06_prs) ----------------------------------------------
# Working directory for the PRS branch. Holds ma/, imputed/, weights/,
# scores_ukb/, scores_adni/, weights_adni/, weights_export/, tables/.
PRS_WORK_DIR=/path/to/work/prs
# Per-region SAIGE summary statistics for the TRAINING split, as
# <dir>/<region>/chr{1..22}.txt. Not the full-sample sumstats used elsewhere:
# the held-out sample must stay out of the weights.
PRS_SUMSTATS_DIR=/path/to/work/ukb_train
# GCTB and its reference data.
GCTB=/path/to/gctb
GCTB_LDM_EIGEN=/path/to/ukbEUR_HM3        # eigen-decomposed LD reference, 591 blocks
GCTB_ANNOT=/path/to/annot_baseline2.2.txt
# The seed alone does not make a run bit-reproducible; the seed WITH
# SBAYESRC_THREADS=1 does. At 4 threads, five runs of one region gave three
# different weight sets. The deposited weights were themselves produced at 4
# threads, one run per region; one thread costs about twice the wall time and is
# the setting that reproduces them, checked for the whole-brain region only.
# See 06_prs/README.md.
SBAYESRC_SEED=20260821
SBAYESRC_THREADS=1
# UK Biobank imputed genotypes, HapMap3 subset; {chr} is substituted 1..22.
UKB_PGEN_TMPL=/path/to/ukb_imp_chr{chr}_v3_hm3
# Optional plink2 --keep for 03_score.sh, FID/IID per line. The published run
# left it unset and scored every participant in the pgen, because ST18 needs
# scores for participants outside the imaging cohort. Set it only to score a
# subset; when set it must be readable and non-empty.
# PRS_UKB_KEEP=/path/to/keep_subset.iids
# Held-out phenotype table. This is what defines the ST17 evaluation sample
# (n = 10,267): 04_analyze_ST17.py inner-joins it against the scores. It must
# carry IID and the per-region BAG column.
PRS_UKB_PHENO=/path/to/covar_regbae_baseline_test.csv
PRS_UKB_BAG_COL={region}_corrected_delta_age_int
# ST18 PheWAS inputs: the phecode matrix (eid, XX<phecode> indicators, Age, Sex,
# PC1..PC10) and the phecode -> phenotype/category catalogue. NaN in an indicator
# column is the phecode exclusion range for a related disease and is dropped from
# that phecode's test; it is not a control.
PRS_PHEWAS_TABLE=/path/to/prs_non_brain_phecodes.csv
PRS_PHECODE_CATALOG=/path/to/phecode_catalog.csv
# Optional analysis-sample restriction for ST18: one participant id per line.
# The White British primary non-imaging analysis (n = 389,045) passes its id list
# here; the unrestricted sensitivity analysis (n = 442,295) and the imaging
# held-out analysis (n = 10,267) set ST18_ALLOW_UNRESTRICTED=1 instead. This
# selects the ANALYSIS sample only -- it is not the plink2 --keep of 03_score.sh
# and not the derivation / held-out split of the weights.
PRS_PHEWAS_KEEP=/path/to/white_british.ids
# Sex designations for the sex-specific phecode test units. The shipped
# 06_prs/sex_specific_phecodes.tsv is the mapping the published run applied
# (134 units: 109 Female, 25 Male). PRS_PHECODE_SEX_DEFS is optional: when set,
# the mapping is re-derived from that definitions table (columns phecode, sex)
# and the run stops if the two disagree.
# PRS_PHECODE_SEX_MAP=/path/to/sex_specific_phecodes.tsv
# PRS_PHECODE_SEX_DEFS=/path/to/phecode_definitions_with_sex.csv
# Units fitted unrestricted despite carrying sex-specific children.
PRS_PHECODE_SEX_AMBIGUOUS=751.1
# ST21-23 ADNI inputs. The scored genotypes come from ADNI_PFILE above.
PRS_ADNI_COVAR=/path/to/adni_covariates.tsv          # IID, DX, AGE, SEX, PC1..PC10
PRS_ADNI_APOE_RAW=/path/to/apoe_dosage.raw           # plink --recode A output
PRS_ADNI_APOE_VARIANT=19:45411941
# ADNI brain-age predictions for the ST21 correlation. Note this is the "norm"
# series, not the ADNI_PRED_TMPL used by 02_adni_replication.
PRS_ADNI_PRED_TMPL=/path/to/adni_brain_age_{region}_norm_seed7.csv
PRS_ADNI_PRED_GLOBAL_TOKEN=imgs
# Deposit package written by 07_export_weights.py. PRS_EXPORT_EXPECTED_N asserts
# the per-region SNP count when set; 0 skips the check.
PRS_EXPORT_DIR=/path/to/work/prs/weights_export
PRS_EXPORT_EXPECTED_N=0
# Optional: override the region list (default is every ukb region in regions.tsv).
# PRS_REGIONS=global,caudate
# plink2 resources per job, and the pool size for the PheWAS logits.
PRS_THREADS=12
PRS_MEMORY_MB=24000
PRS_NPROC=24
